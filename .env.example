# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brand (set per Vercel project: "lf" or "sb")
VITE_BRAND_SITE=

# Payments (public key only; secret keys belong in Vercel, never VITE_*)
VITE_PAYCHANGU_PUBLIC_KEY=
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=

# Email (Brevo). Server side only. Never use VITE_BREVO_API_KEY.
BREVO_API_KEY=
BREVO_LIST_ID=
ADMIN_EMAIL=
ALLOWED_APP_ORIGINS=

# Subscription cron. Vercel injects this as the Bearer token for the cron route.
CRON_SECRET=

# Public Lake Fresh contact details. Leave blank to hide the channel.
VITE_LF_WHATSAPP=
VITE_LF_PHONE=
VITE_LF_EMAIL=
VITE_LF_ADDRESS=
VITE_LF_REGISTRATION=

# Public Streetwear Blantyre WhatsApp number
VITE_WHATSAPP_BUSINESS=

# AI (Gemini) - used by api/ai-message.ts and supabase edge fn
GEMINI_KEY=
GEMINI_API_KEY=

# Error tracking (optional but recommended for production)
# Create a project at sentry.io and paste the DSN here.
VITE_SENTRY_DSN=
